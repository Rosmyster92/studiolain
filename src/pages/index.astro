---
import Layout from '~/layouts/PageLayout.astro';

import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import HeroSlider from '~/components/chiaro/HeroSlider.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Studio Lain & Partners — Consulenza del Lavoro a Malo (VI)',
  ignoreTitleTemplate: true,
  description:
    'Studio di Consulenza del Lavoro fondato nel 1997. Diritto del lavoro, gestione del personale, costi del lavoro, ricerca e selezione, sicurezza sul lavoro.',
};

const CHIARO = process.env.THEME === 'chiaro';
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    description:
      'Studio di consulenza del lavoro: amministrazione del personale, elaborazione paghe, consulenza contrattuale e previdenziale.',
    vatID: 'IT02569290246',
    areaServed: [
      { '@type': 'AdministrativeArea', name: 'Provincia di Vicenza' },
      { '@type': 'State', name: 'Veneto' },
    ],
    telephone: '+390445602944',
    email: 'studiolain@studiolain.com',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Via Marano, 8',
      addressLocality: 'Malo',
      addressRegion: 'VI',
      postalCode: '36034',
      addressCountry: 'IT',
    },
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  {CHIARO && <HeroSlider />}
  {
    !CHIARO && (
      <HeroText
        tagline="Consulenza del Lavoro · Malo (VI)"
        callToAction={{
          variant: 'primary',
          text: 'I nostri servizi',
          href: getPermalink('/servizi'),
          icon: 'tabler:briefcase',
        }}
        callToAction2={{
          text: 'Contattaci',
          href: getPermalink('/contatti'),
        }}
      >
        <Fragment slot="title">
          Studio Lain & Partners
          <br />
          <span class="text-accent dark:text-white">al fianco delle imprese</span>
        </Fragment>
        <Fragment slot="subtitle">
          Dal 1997 accompagniamo aziende e professionisti in diritto del lavoro, gestione del personale e costi del
          lavoro.
        </Fragment>
      </HeroText>
    )
  }

  <Features2
    id="servizi"
    tagline="Servizi"
    title="Cosa possiamo fare per voi"
    subtitle="Consulenza del lavoro e HR, con partnership per ricerca, selezione e sicurezza."
    columns={3}
    items={[
      {
        title: 'Consulenza del lavoro',
        description: 'Diritto del lavoro, contrattualistica e supporto nelle fasi del rapporto di lavoro.',
        icon: 'tabler:scale',
      },
      {
        title: 'Gestione paghe e adempimenti',
        description: 'Amministrazione del personale, scadenze e comunicazioni obbligatorie.',
        icon: 'tabler:file-invoice',
      },
      {
        title: 'HR / gestione del personale',
        description: 'Supporto operativo alla direzione HR e allineamento alle prassi aziendali.',
        icon: 'tabler:users',
      },
      {
        title: 'Costi e politiche retributive',
        description: 'Analisi del costo del lavoro, welfare e sistemi di incentivazione.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Ricerca e selezione',
        description: 'In collaborazione con Eurointerim S.p.A.',
        icon: 'tabler:user-search',
      },
      {
        title: 'Sicurezza sul lavoro',
        description: 'Con Eurointerim Servizi S.p.A.',
        icon: 'tabler:shield-check',
      },
    ]}
  />

  {
    CHIARO && (
      <section class="not-prose max-w-7xl mx-auto px-4 sm:px-6 py-12 grid md:grid-cols-2 gap-10 items-center">
        <img
          src={import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'images/studio/ufficio-1.webp'}
          alt="Lo Studio al lavoro"
          class="w-full h-80 object-cover"
          loading="lazy"
        />
        <div>
          <p class="uppercase tracking-widest text-xs font-semibold text-primary mb-3">Chi siamo</p>
          <h2 class="font-heading text-3xl md:text-4xl text-heading mb-4">Dal 1997 a Malo (VI)</h2>
          <p class="text-muted text-lg mb-6">
            Paola Lain, Massimo Lain e Alessandro Roso: competenze complementari in consulenza del lavoro, paghe e
            risorse umane.
          </p>
          <a href={getPermalink('/chi-siamo')} class="font-semibold text-primary">
            Conosci i professionisti →
          </a>
        </div>
      </section>
    )
  }

  <BlogLatestPosts
    title="Ultime novità normative"
    linkText="Tutte le novità normative"
    information="Aggiornamenti su lavoro, contributi e adempimenti utili alle aziende."
    count={3}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Richiedi una consulenza',
        href: getPermalink('/contatti'),
        icon: 'tabler:mail',
      },
      {
        text: 'Chi siamo',
        href: getPermalink('/chi-siamo'),
      },
    ]}
  >
    <Fragment slot="title">Parliamone insieme</Fragment>
    <Fragment slot="subtitle">
      Contattate lo Studio per un preventivo o una consulenza su personale e adempimenti.
    </Fragment>
  </CallToAction>
</Layout>
