---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contatti',
  description:
    'Contatta Studio Lain & Partners: Via Marano, 8 — 36034 Malo (VI). Tel. 0445 602944 — studiolain@studiolain.com',
};
---

<Layout metadata={metadata}>
  <HeroText title="Come raggiungerci" />

  <ContactUs
    id="form"
    title="Scrivete allo Studio"
    subtitle="Compilate il modulo oppure utilizzate telefono ed e-mail. Risponderemo nel più breve tempo possibile."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Nome e cognome',
      },
      {
        type: 'email',
        name: 'email',
        label: 'E-mail',
      },
    ]}
    textarea={{
      label: 'Messaggio',
    }}
    disclaimer={{
      label: 'Dichiaro di aver letto l’informativa privacy (pagina Privacy del sito).',
    }}
    button="Invia messaggio"
    action="https://formsubmit.co/paola@studiolain.com"
    cc="alessandro.roso@studiolain.com"
    subject="Nuovo messaggio dal sito Studio Lain & Partners"
    description="Preferite una risposta rapida? Chiamate lo 0445 602944."
  />

  <Features2
    title="Recapiti"
    items={[
      {
        title: 'Sede',
        description: 'Via Marano, 8 — 36034 Malo (VI)',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Telefono',
        description: '0445 602944',
        icon: 'tabler:phone',
      },
      {
        title: 'E-mail',
        description: 'studiolain@studiolain.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Privacy',
        description: 'Informativa sul trattamento dei dati personali nella pagina Privacy.',
        icon: 'tabler:lock',
      },
      {
        title: 'Orari',
        description: 'Contattateci per fissare un appuntamento in sede o in modalità remota.',
        icon: 'tabler:clock',
      },
      {
        title: 'Novità normative',
        description: 'Aggiornamenti normativi e note operative nella sezione Novità normative del sito.',
        icon: 'tabler:news',
      },
    ]}
  />
</Layout>
