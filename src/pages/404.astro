---
import Layout from '~/layouts/Layout.astro';
import { getHomePermalink } from '~/utils/permalinks';

const title = `Pagina non trovata (404)`;
---

<Layout metadata={{ title }}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <h2 class="mb-8 font-bold text-9xl">
          <span class="sr-only">Errore</span>
          <span class="text-primary">404</span>
        </h2>
        <p class="text-3xl font-semibold md:text-3xl">La pagina che cercate non esiste o è stata spostata.</p>
        <p class="mt-4 mb-8 text-lg text-muted dark:text-slate-400">
          Potete tornare alla pagina iniziale o consultare le novità normative.
        </p>
        <a rel="noopener noreferrer" href={getHomePermalink()} class="btn ml-4">Torna alla pagina iniziale</a>
      </div>
    </div>
  </section>
</Layout>
