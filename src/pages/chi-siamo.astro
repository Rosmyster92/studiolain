---
import Features2 from '~/components/widgets/Features2.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Chi siamo',
  description:
    'Studio Lain & Partners: Consulenza del Lavoro a Malo (VI). Fondato nel 1997 da Paola e Massimo Lain; dal 2017 con Alessandro Roso.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Chi siamo"
    callToAction={{ variant: 'primary', text: 'I servizi', href: getPermalink('/servizi') }}
    callToAction2={{ text: 'Contatti', href: getPermalink('/contatti') }}
  >
    <Fragment slot="title">
      Uno studio di <span class="text-accent dark:text-white">Consulenza del Lavoro</span>
    </Fragment>
    <Fragment slot="subtitle">
      Lo Studio Lain nasce nel 1997 per iniziativa della Dott.ssa Paola Lain, laureata in Economia e Organizzazione
      Aziendale e iscritta all’Ordine dei Consulenti del Lavoro di Vicenza dal 1996, e del Dott. Massimo Lain, laureato
      in Economia e Commercio e H.R. Dal 2017, l’attività si è arricchita del contributo del Dott. Alessandro Roso,
      laureato in Economia e Direzione Aziendale e iscritto all’Ordine dei Consulenti del Lavoro di Vicenza dal 2021.
    </Fragment>
  </HeroText>

  <section class="px-4 sm:px-6 max-w-3xl mx-auto pb-8 md:pb-12 -mt-4 md:-mt-8">
    <p class="text-lg text-muted dark:text-slate-300 text-pretty">
      Con sede a Malo (VI), lo Studio si distingue per l’elevata professionalità e la capacità di offrire soluzioni
      personalizzate nella consulenza del lavoro e nella gestione delle risorse umane. Completano l’offerta ricerca e
      selezione con Eurointerim S.p.A. e sicurezza sul lavoro con Eurointerim Servizi S.p.A.
    </p>
  </section>

  <Features2
    title="I professionisti"
    subtitle="Competenze complementari a servizio di imprese e lavoratori."
    columns={3}
    items={[
      {
        title: 'Dott.ssa Paola Lain',
        description:
          'Economia e Organizzazione Aziendale. Iscritta all’Ordine dei Consulenti del Lavoro di Vicenza dal 1996. Co-fondatrice.',
        icon: 'tabler:user',
      },
      {
        title: 'Dott. Massimo Lain',
        description:
          'Economia e Commercio, esperienza in Human Resources. Co-fondatore e riferimento per temi organizzativi e HR.',
        icon: 'tabler:user',
      },
      {
        title: 'Dott. Alessandro Roso',
        description:
          'Economia e Direzione Aziendale. Iscritto all’Ordine dei Consulenti del Lavoro di Vicenza dal 2021. In Studio dal 2017.',
        icon: 'tabler:user',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Richiedi una consulenza',
        href: getPermalink('/contatti'),
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">Parliamo della vostra azienda</Fragment>
    <Fragment slot="subtitle">Siamo a Malo (VI): Via Marano, 8 — Tel. 0445 602944</Fragment>
  </CallToAction>
</Layout>
