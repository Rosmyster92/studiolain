---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features2 from '~/components/widgets/Features2.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Servizi',
  description:
    'Servizi di Consulenza del Lavoro: diritto del lavoro, gestione paghe, HR, costi e politiche retributive, ricerca e selezione, sicurezza sul lavoro.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Servizi"
    title="Consulenza del Lavoro per imprese e professionisti"
    subtitle="Adempimenti, gestione del personale e ottimizzazione dei costi del lavoro, con partnership per selezione e sicurezza."
    callToAction={{ variant: 'primary', text: 'Contattaci', href: getPermalink('/contatti') }}
  />

  <Features2
    title="Le nostre aree di intervento"
    subtitle="Supporto chiaro e operativo, senza complessità superflue."
    columns={3}
    items={[
      {
        title: 'Consulenza del lavoro / diritto del lavoro',
        description:
          'Contrattualistica, disciplina del rapporto di lavoro, procedure e adempimenti collegati alle scelte aziendali.',
        icon: 'tabler:scale',
      },
      {
        title: 'Gestione paghe e adempimenti',
        description:
          'Amministrazione del personale, scadenze, comunicazioni obbligatorie e supporto quotidiano alla direzione.',
        icon: 'tabler:file-invoice',
      },
      {
        title: 'HR / gestione del personale',
        description: 'Organizzazione del personale, processi HR e allineamento alle prassi e agli obiettivi aziendali.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Analisi costi del lavoro e politiche retributive',
        description:
          'Lettura del costo del lavoro, simulazioni, welfare e strumenti di incentivazione coerenti con budget e CCNL.',
        icon: 'tabler:chart-dots',
      },
      {
        title: 'Ricerca e selezione (Eurointerim)',
        description:
          'In collaborazione con Eurointerim S.p.A.: individuazione e selezione di candidati allineati al profilo richiesto.',
        icon: 'tabler:user-search',
      },
      {
        title: 'Sicurezza sul lavoro (Eurointerim Servizi)',
        description:
          'Con Eurointerim Servizi S.p.A.: supporto agli obblighi di salute e sicurezza nei luoghi di lavoro.',
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Chiedi un preventivo',
        href: getPermalink('/contatti'),
        icon: 'tabler:phone',
      },
    ]}
  >
    <Fragment slot="title">Serve un supporto su un caso concreto?</Fragment>
    <Fragment slot="subtitle"
      >Scriveteci o chiamateci: valuteremo insieme le priorità della vostra organizzazione.</Fragment
    >
  </CallToAction>
</Layout>
