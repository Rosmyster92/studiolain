---
import { APP_BLOG } from 'astrowind:config';

import { getRelatedPosts } from '~/utils/blog';
import ListItem from '~/components/blog/ListItem.astro';
import type { Post } from '~/types';
import { getBlogPermalink } from '~/utils/permalinks';

export interface Props {
  post: Post;
}

const { post } = Astro.props;

const relatedPosts = post.tags ? await getRelatedPosts(post, 4) : [];
---

{
  APP_BLOG.isRelatedPostsEnabled && relatedPosts.length ? (
    <section class="mx-auto px-6 sm:px-6 max-w-3xl pb-12" aria-labelledby="related-title">
      <div class="flex items-baseline justify-between gap-4 mb-2">
        <h2 id="related-title" class="text-xl font-bold font-heading">
          Articoli correlati
        </h2>
        <a class="text-sm font-semibold text-primary dark:text-blue-400 hover:underline" href={getBlogPermalink()}>
          Tutte le novità normative »
        </a>
      </div>
      <div>
        {relatedPosts.map((p) => (
          <ListItem post={p} />
        ))}
      </div>
    </section>
  ) : null
}
