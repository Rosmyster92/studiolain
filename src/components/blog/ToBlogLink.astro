---
import { Icon } from 'astro-icon/components';
import { getBlogPermalink } from '~/utils/permalinks';
---

<div class="mx-auto px-6 sm:px-6 max-w-3xl pt-8 md:pt-4">
  <div class="flex justify-between flex-row flex-wrap gap-2">
    <a
      class="btn btn-tertiary text-muted dark:text-slate-400 hover:text-primary dark:hover:text-gray-200 transition"
      href={getBlogPermalink()}
      ><Icon name="tabler:chevron-left" class="w-5 h-5 mr-1 -ml-1.5 rtl:ml-1 rtl:-mr-1.5" /> Torna alle novità</a
    >
  </div>
</div>
