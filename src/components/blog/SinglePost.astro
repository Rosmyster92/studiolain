---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';
import Button from '~/components/ui/Button.astro';

import { getPermalink, getAsset } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';
import { AUTHOR } from '~/utils/author';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
const isCircolare = post.category?.title === 'Circolari Studio';
const showToc = !isCircolare && (post.wordCount ?? 0) > 1000 && (post.headings?.length ?? 0) >= 3;
const authorHref = getPermalink('/chi-siamo') + '#' + AUTHOR.anchor;
---

<section class="py-8 sm:py-16 lg:py-20 mx-auto">
  <article>
    <header class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
      <div class="flex justify-between flex-col sm:flex-row max-w-3xl mx-auto mt-0 mb-2 px-4 sm:px-6 sm:items-center">
        <p>
          <Icon name="tabler:calendar" class="w-4 h-4 inline-block -mt-0.5 text-primary dark:text-blue-400" />
          <time
            datetime={post.publishDate.toISOString()}
            class="inline-block text-base font-semibold text-primary dark:text-blue-400"
            >{getFormattedDate(post.publishDate)}</time
          >
          {
            post.updateDate && post.updateDate.getTime() !== post.publishDate.getTime() && (
              <>
                {' '}
                ·{' '}
                <span class="inline-block">
                  Aggiornato il{' '}
                  <time datetime={post.updateDate.toISOString()}>{getFormattedDate(post.updateDate)}</time>
                </span>
              </>
            )
          }
          {
            isCircolare ? (
              post.author && (
                <>
                  {' '}
                  · <span class="inline-block">{post.author}</span>
                </>
              )
            ) : (
              <>
                {' '}
                · <Icon name="tabler:user" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
                <a class="inline-block hover:underline" href={authorHref} rel="author">
                  {AUTHOR.name}
                </a>
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}
                ·{' '}
                <a class="hover:underline inline-block" href={getPermalink(post.category.slug, 'category')}>
                  {post.category.title}
                </a>
              </>
            )
          }
        </p>
      </div>

      <h1
        class="px-4 sm:px-6 max-w-3xl mx-auto text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading"
      >
        {post.title}
      </h1>
      <div class="mb-8"></div>

      {
        post.image ? (
          <Image
            src={post.image}
            class="max-w-full lg:max-w-[900px] mx-auto mb-6 sm:rounded-md bg-gray-400 dark:bg-slate-700"
            widths={[400, 900]}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post.imageAlt || ''}
            width={900}
            height={506}
            format="webp"
            loading="eager"
            decoding="async"
          />
        ) : (
          <div class="max-w-3xl mx-auto px-4 sm:px-6">
            <div class="border-t dark:border-slate-700" />
          </div>
        )
      }
    </header>
    <div
      class:list={[
        post.category?.title === 'Circolari Studio' ? 'circolare-body' : 'article-body',
        'mx-auto px-6 sm:px-6 max-w-3xl prose dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg mt-8 prose-headings:scroll-mt-[80px] prose-li:my-0',
      ]}
    >
      {
        showToc && (
          <nav class="toc not-prose" id="post-toc" aria-label="Indice">
            <p class="toc-title">Indice</p>
            <ol>
              {post.headings!.map((h) => (
                <li class={h.depth === 3 ? 'toc-sub' : ''}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <slot />
      {
        post.faq?.length ? (
          <section class="faq" aria-labelledby="faq-title">
            <h2 id="faq-title">Domande frequenti</h2>
            {post.faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        ) : null
      }
    </div>

    {
      showToc && (
        <script is:inline>
          (function () {
            var t = document.getElementById('post-toc');
            if (!t) return;
            var b = t.parentElement;
            var h = b.querySelector(':scope > h2, :scope > h3');
            if (h) b.insertBefore(t, h);
          })();
        </script>
      )
    }


    <script is:inline>
      (function () {
        var COPY = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>';
        var OK = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>';
        var DL = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12m0 0l-5-5m5 5l5-5M5 20h14"/></svg>';
        var rows = function (t) {
          return Array.prototype.map.call(t.rows, function (r) {
            return Array.prototype.map.call(r.cells, function (c) { return c.innerText.replace(/\s+/g, ' ').trim(); });
          });
        };
        document.querySelectorAll('article .prose table').forEach(function (t, i) {
          var bar = document.createElement('div');
          bar.className = 'tbl-tools not-prose';
          var c = document.createElement('button');
          c.type = 'button'; c.className = 'tbl-btn'; c.innerHTML = COPY;
          c.setAttribute('aria-label', 'Copia tabella'); c.title = 'Copia tabella';
          c.onclick = function () {
            var txt = rows(t).map(function (r) { return r.join('\t'); }).join('\n');
            navigator.clipboard.writeText(txt).then(function () {
              c.innerHTML = OK; c.title = 'Copiata'; c.setAttribute('aria-label', 'Tabella copiata');
              setTimeout(function () { c.innerHTML = COPY; c.title = 'Copia tabella'; c.setAttribute('aria-label', 'Copia tabella'); }, 1800);
            });
          };
          var d = document.createElement('button');
          d.type = 'button'; d.className = 'tbl-btn'; d.innerHTML = DL + '<span>CSV</span>';
          d.setAttribute('aria-label', 'Scarica tabella (CSV)'); d.title = 'Scarica tabella (CSV)';
          d.onclick = function () {
            var csv = rows(t).map(function (r) { return r.map(function (v) { return '"' + v.replace(/"/g, '""') + '"'; }).join(';'); }).join('\r\n');
            var a = document.createElement('a');
            a.href = URL.createObjectURL(new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8' }));
            a.download = (document.title.split('|')[0].trim().replace(/[^\w\u00C0-\u017F]+/g, '-').slice(0, 60) || 'tabella') + '-' + (i + 1) + '.csv';
            a.click(); setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
          };
          bar.appendChild(c); bar.appendChild(d);
          if (!(t.parentElement && t.parentElement.classList.contains('tbl-scroll'))) {
            var w = document.createElement('div');
            w.className = 'tbl-scroll'; w.tabIndex = 0; w.setAttribute('role', 'region'); w.setAttribute('aria-label', 'Tabella scorrevole');
            t.parentElement.insertBefore(w, t); w.appendChild(t);
          }
          var host = t.parentElement;
          if (t.rows[0] && t.rows[0].cells.length >= 4) host.classList.add('tbl-sticky');
          if (host !== t) {
            var upd = function () {
              var max = host.scrollWidth - host.clientWidth;
              host.classList.toggle('shadow-r', max > 1 && host.scrollLeft < max - 1);
              host.classList.toggle('shadow-l', host.scrollLeft > 1);
            };
            host.addEventListener('scroll', upd, { passive: true });
            window.addEventListener('resize', upd);
            upd();
          }
          host.parentElement.insertBefore(bar, host);
        });
      })();
    </script>

    {
      post.pdf && (
        <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-8">
          <Button
            variant="primary"
            text="Scarica la circolare (PDF)"
            href={getAsset(post.pdf)}
            icon="tabler:file-download"
            target="_blank"
          />
        </div>
      )
    }

    {
      post.source && (
        <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-10">
          <p class="border-t border-slate-200 dark:border-slate-700 pt-4 text-sm sm:text-base">
            <strong>Fonte:</strong> {post.source.name} —{' '}
            <a
              href={post.source.url}
              target="_blank"
              rel="noopener"
              class="text-primary dark:text-blue-400 underline break-words"
            >
              {post.source.url.replace(/^https?:\/\//, '').split('/')[0]} (testo ufficiale)
            </a>
          </p>
        </div>
      )
    }

    {
      !isCircolare && (
        <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-8">
          <div class="author-box border-l-2 border-primary pl-4 text-sm sm:text-base">
            <p class="font-semibold text-heading">
              <a href={authorHref} rel="author" class="hover:underline">
                {AUTHOR.name}
              </a>{' '}
              · {AUTHOR.jobTitle}
            </p>
            <p class="text-muted dark:text-slate-400 mt-1">{AUTHOR.bio}</p>
          </div>
        </div>
      )
    }

    <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-12">
      <div
        class="rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50 p-6 sm:p-8 text-center"
      >
        <p class="text-lg font-semibold text-heading mb-2">Serve un supporto su questo tema?</p>
        <p class="text-muted dark:text-slate-400 mb-5">
          Contattate lo Studio per una consulenza o un preventivo personalizzato.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <Button
            variant="primary"
            text="Richiedi una consulenza"
            href={getPermalink('/contatti')}
            icon="tabler:mail"
          />
          <Button text="Chiedi un preventivo" href={getPermalink('/contatti')} icon="tabler:file-description" />
        </div>
      </div>
    </div>

    <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-8 flex justify-between flex-col sm:flex-row">
      <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
      <SocialShare url={url} text={post.title} class="mt-5 sm:mt-1 align-middle text-gray-500 dark:text-slate-600" />
    </div>
  </article>
</section>

<style is:global>
  .circolare-body {
    font-size: 15px;
    line-height: 1.45;
  }
  .circolare-body p,
  .circolare-body ul,
  .circolare-body ol,
  .circolare-body table {
    margin-top: 0.35em;
    margin-bottom: 0.35em;
  }
  .circolare-body li {
    margin-top: 0.1em;
    margin-bottom: 0.1em;
  }
  .circolare-body li > p {
    margin: 0;
  }
  .circolare-body ul ul,
  .circolare-body ol ol,
  .circolare-body ul ol,
  .circolare-body ol ul {
    margin-top: 0.1em;
    margin-bottom: 0.1em;
  }
  .circolare-body h1,
  .circolare-body h2,
  .circolare-body h3,
  .circolare-body h4 {
    font-size: 1.1em;
    line-height: 1.3;
    margin-top: 1em;
    margin-bottom: 0.3em;
    letter-spacing: 0;
  }
  .circolare-body table {
    border-collapse: collapse;
    width: 100%;
  }
  .circolare-body th,
  .circolare-body td {
    border: 1px solid currentColor;
    border-color: rgb(148 163 184 / 0.6);
    padding: 4px 6px;
    vertical-align: top;
  }
  .circolare-body td p,
  .circolare-body th p {
    margin: 0;
  }
  /* Tabelle: stesso carattere, corpo, peso e interlinea del testo (articoli e circolari, entrambi i temi) */
  article .prose table,
  article .prose thead,
  article .prose tbody,
  article .prose tr,
  article .prose th,
  article .prose td,
  article .prose th *,
  article .prose td * {
    font-family: inherit !important;
    font-size: inherit !important;
    line-height: inherit !important;
  }
  article .prose td,
  article .prose td * {
    font-weight: inherit !important;
  }
  article .prose th {
    background: rgb(127 127 127 / 8%);
  }
  /* Indice */
  .toc {
    border: 1px solid rgb(127 127 127 / 25%);
    padding: 0.9rem 1.2rem;
    margin: 0 0 2rem;
    font-size: 0.95rem;
  }
  .toc-title {
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
  .toc ol {
    list-style: decimal;
    padding-left: 1.3rem;
    margin: 0;
  }
  .toc li {
    margin: 0.15rem 0;
  }
  .toc li.toc-sub {
    list-style: none;
    margin-left: 1rem;
    font-size: 0.92em;
  }
  .toc a {
    text-decoration: none;
    color: var(--aw-color-primary);
  }
  .toc a:hover {
    text-decoration: underline;
  }
  /* Riquadri */
  .prose aside.callout {
    border-left: 4px solid;
    padding: 0.6rem 1rem;
    margin: 1.4em 0;
    background: rgb(127 127 127 / 6%);
  }
  .prose aside.callout > :first-child {
    margin-top: 0;
  }
  .prose aside.callout > :last-child {
    margin-bottom: 0;
  }
  .prose aside.callout .callout-title {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85em;
    margin-bottom: 0.3em;
  }
  .prose aside.callout-attenzione {
    border-color: #c2410c;
  }
  .prose aside.callout-attenzione .callout-title {
    color: #c2410c;
  }
  .prose aside.callout-nota {
    border-color: #2563eb;
  }
  .prose aside.callout-nota .callout-title {
    color: #2563eb;
  }
  .prose aside.callout-azienda {
    border-color: #15803d;
  }
  .prose aside.callout-azienda .callout-title {
    color: #15803d;
  }
  .prose aside.callout-inbreve {
    border-color: var(--aw-color-primary);
    background: rgb(127 127 127 / 9%);
  }
  .prose aside.callout-inbreve .callout-title {
    color: var(--aw-color-primary);
  }
  /* FAQ */
  .prose .faq details {
    border-top: 1px solid rgb(127 127 127 / 25%);
    padding: 0.6rem 0;
  }
  .prose .faq summary {
    cursor: pointer;
    font-weight: 600;
  }
  .prose .faq details p {
    margin: 0.4rem 0 0;
  }
  /* Tabelle larghe: scorrimento orizzontale */
  .tbl-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; scrollbar-width: thin; scrollbar-color: rgb(127 127 127 / 45%) transparent; margin: 1em 0; position: relative; }
  .tbl-scroll::-webkit-scrollbar { height: 6px; }
  .tbl-scroll::-webkit-scrollbar-thumb { background: rgb(127 127 127 / 45%); border-radius: 3px; }
  .tbl-scroll > table { margin: 0 !important; min-width: 100%; }
  .tbl-scroll.shadow-r { box-shadow: inset -14px 0 10px -10px rgb(0 0 0 / 28%); }
  .tbl-scroll.shadow-l { box-shadow: inset 14px 0 10px -10px rgb(0 0 0 / 28%); }
  .tbl-scroll.shadow-l.shadow-r { box-shadow: inset 14px 0 10px -10px rgb(0 0 0 / 28%), inset -14px 0 10px -10px rgb(0 0 0 / 28%); }
  .tbl-scroll:focus-visible { outline: 2px solid var(--aw-color-primary); outline-offset: 2px; }
  .tbl-sticky th:first-child, .tbl-sticky td:first-child { position: sticky; left: 0; z-index: 1; background: var(--aw-color-bg-page, #fff); }
  .tbl-sticky th:first-child { background: color-mix(in srgb, var(--aw-color-bg-page, #fff) 92%, #808080); }
  @media (max-width: 640px) { .prose .tbl-scroll th, .prose .tbl-scroll td { min-width: 7rem; } }
  .tbl-tools { display: flex; justify-content: flex-end; gap: 0.4rem; margin: 1em 0 -0.6em; }
  .tbl-btn { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.8rem; padding: 0.25rem 0.45rem; border: 1px solid rgb(127 127 127 / 30%); border-radius: 3px; background: transparent; color: inherit; opacity: 0.75; cursor: pointer; }
  .tbl-btn:hover, .tbl-btn:focus-visible { opacity: 1; border-color: var(--aw-color-primary); color: var(--aw-color-primary); }
</style>
