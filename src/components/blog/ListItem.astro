---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article class="flex gap-4 py-3 border-b border-slate-200 dark:border-slate-800">
  <time
    datetime={post.publishDate.toISOString()}
    class="shrink-0 w-24 pt-0.5 text-sm font-semibold tabular-nums text-primary dark:text-blue-400"
  >
    {getFormattedDate(post.publishDate)}
  </time>
  <div class="min-w-0">
    <h2 class="text-base sm:text-lg font-semibold leading-snug font-heading dark:text-slate-200">
      {
        link ? (
          <a class="hover:text-primary dark:hover:text-blue-400 transition" href={link}>
            {post.title}
          </a>
        ) : (
          post.title
        )
      }
      {
        post.category && (
          <a
            class="ml-1 align-middle inline-block rounded bg-gray-100 dark:bg-slate-700 px-1.5 py-0.5 text-xs font-medium text-muted hover:text-primary"
            href={getPermalink(post.category.slug, 'category')}
          >
            {post.category.title}
          </a>
        )
      }
    </h2>
    {
      post.excerpt && (
        <p class="mt-1 text-sm text-muted dark:text-slate-400 leading-relaxed line-clamp-2">{post.excerpt}</p>
      )
    }
  </div>
</article>
