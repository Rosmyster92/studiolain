---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// Stack: system-ui + Inter for a light, modern professional feel.
---

<style is:inline>
  :root {
    --aw-font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', var(--font-inter), sans-serif;
    --aw-font-serif: var(--aw-font-sans);
    --aw-font-heading: var(--aw-font-sans);

    --aw-color-primary: rgb(1 97 239);
    --aw-color-secondary: rgb(1 84 207);
    --aw-color-accent: rgb(109 40 217);

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(8 9 10);

    ::selection {
      background-color: lavender;
    }
  }

  .dark {
    --aw-font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', var(--font-inter), sans-serif;
    --aw-font-serif: var(--aw-font-sans);
    --aw-font-heading: var(--aw-font-sans);

    --aw-color-primary: rgb(1 97 239);
    --aw-color-secondary: rgb(1 84 207);
    --aw-color-accent: rgb(109 40 217);

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(8 9 10);

    ::selection {
      background-color: black;
      color: snow;
    }
  }

  /* ---- Tema chiaro (THEME=chiaro): neutro, molto leggibile, spazi ampi ---- */
  html.theme-chiaro {
    --aw-font-heading: Georgia, 'Times New Roman', serif;
    --aw-color-primary: rgb(176 30 46);
    --aw-color-secondary: rgb(140 22 36);
    --aw-color-accent: rgb(176 30 46);
    --aw-color-text-heading: rgb(20 20 20);
    --aw-color-text-default: rgb(38 38 38);
    --aw-color-text-muted: rgb(38 38 38 / 70%);
    --aw-color-bg-page: rgb(255 255 255);
    font-size: 17px;
  }
  html.theme-chiaro body {
    line-height: 1.65;
  }
  html.theme-chiaro h1,
  html.theme-chiaro h2,
  html.theme-chiaro h3 {
    font-weight: 500;
    letter-spacing: -0.015em;
  }
  html.theme-chiaro section:not(.hs) {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }
  html.theme-chiaro header {
    border-bottom: 1px solid rgb(0 0 0 / 8%);
    background: #fff;
  }
  html.theme-chiaro footer {
    background: rgb(246 245 243);
  }
  html.theme-chiaro .bg-white,
  html.theme-chiaro .shadow {
    box-shadow: none;
  }
  html.theme-chiaro article,
  html.theme-chiaro .rounded-lg {
    border-radius: 2px;
  }

  body {
    letter-spacing: -0.011em;
    font-weight: 400;
  }

  h1,
  h2,
  h3,
  .font-heading {
    letter-spacing: -0.025em;
    font-weight: 600;
  }

  /* studiolain: reveal-on-scroll disabled — keep content visible */
  @media (min-width: 768px) {
    .motion-safe\:md\:opacity-0 {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
  }
</style>
